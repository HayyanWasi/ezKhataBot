# ==============================================================================
# Evolution API & Supabase Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=
SERVER_URL=

# ------------------------------------------------------------------------------
# 2. Authentication
# ------------------------------------------------------------------------------
AUTHENTICATION_TYPE=
AUTHENTICATION_API_KEY=
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=

# ------------------------------------------------------------------------------
# 3. Database: Supabase PostgreSQL
# ------------------------------------------------------------------------------
DATABASE_PROVIDER=

# Supabase Connection Pooler (Session Mode on 5432 for Prisma migrations):
DATABASE_CONNECTION_URI=
DATABASE_CLIENT_NAME=

# Note: If Evolution API prisma migrations ever require session mode instead of transaction mode, switch port 6543 to 5432:
# DATABASE_CONNECTION_URI=postgresql://postgres.suvizmpecohfcogauhjw:v6PMs%26EQgt-jv%2FU@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?schema=evolution_api

# ------------------------------------------------------------------------------
# 4. Redis Cache (Managed automatically by docker-compose)
# ------------------------------------------------------------------------------
CACHE_REDIS_ENABLED=
CACHE_REDIS_URI=
CACHE_REDIS_PREFIX_KEY=
CACHE_REDIS_SAVE_INSTANCES=
CACHE_LOCAL_ENABLED=

# ------------------------------------------------------------------------------
# 5. Optional: Supabase Storage (S3-compatible) for WhatsApp Media
# ------------------------------------------------------------------------------
S3_ENABLED=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PORT=
S3_ENDPOINT=
S3_REGION=
S3_USE_SSL=

# ------------------------------------------------------------------------------
# 6. Optional: Webhook (Forward WhatsApp events to local bot)
# ------------------------------------------------------------------------------
WEBHOOK_GLOBAL_ENABLED=
WEBHOOK_GLOBAL_URL=


API_URL=
API_KEY=
INSTANCE=
INSTANCE_TOKEN=

ALLOWED_NUMBER=
CONFIG_SESSION_PHONE_VERSION=
LOG_LEVEL=
# ------------------------------------------------------------------------------
# 7. EzKhata app
# ------------------------------------------------------------------------------
# Supabase Postgres for app data (public schema) - fill in (no ?schema=evolution_api)
APP_DATABASE_URL=
# LLM (OpenAI-compatible: Groq / OpenRouter)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Optional: comma-separated keys tried in order when the main key hits a rate limit
LLM_FALLBACK_API_KEYS=
LLM_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 8. Observability: LangSmith tracing (https://smith.langchain.com -> Settings -> API Keys)
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ezkhata-dev
# EU region only: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
