# ==============================================================================
# Evolution API & Supabase Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=
SERVER_URL=

# ------------------------------------------------------------------------------
# 2. Authentication
# ------------------------------------------------------------------------------
AUTHENTICATION_TYPE=
AUTHENTICATION_API_KEY=
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=

# ------------------------------------------------------------------------------
# 3. Database: Supabase PostgreSQL
# ------------------------------------------------------------------------------
DATABASE_PROVIDER=

# Supabase Connection Pooler (Session Mode on 5432 for Prisma migrations):
DATABASE_CONNECTION_URI=
DATABASE_CLIENT_NAME=
# Evolution keeps only the WhatsApp login (instance + session); chats and messages are not stored
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# Note: If Evolution API prisma migrations ever require session mode instead of transaction mode, switch port 6543 to 5432:
# DATABASE_CONNECTION_URI=postgresql://postgres.suvizmpecohfcogauhjw:YOUR-DB-PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?schema=evolution_api

# ------------------------------------------------------------------------------
# 4. Redis Cache (Managed automatically by docker-compose)
# ------------------------------------------------------------------------------
CACHE_REDIS_ENABLED=
CACHE_REDIS_URI=
CACHE_REDIS_PREFIX_KEY=
CACHE_REDIS_SAVE_INSTANCES=
CACHE_LOCAL_ENABLED=

# ------------------------------------------------------------------------------
# 5. Optional: Supabase Storage (S3-compatible) for WhatsApp Media
# ------------------------------------------------------------------------------
S3_ENABLED=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PORT=
S3_ENDPOINT=
S3_REGION=
S3_USE_SSL=

# ------------------------------------------------------------------------------
# 6. Optional: Webhook (Forward WhatsApp events to local bot)
# ------------------------------------------------------------------------------
WEBHOOK_GLOBAL_ENABLED=
WEBHOOK_GLOBAL_URL=


API_URL=
API_KEY=
INSTANCE=
INSTANCE_TOKEN=

ALLOWED_NUMBER=
CONFIG_SESSION_PHONE_VERSION=
LOG_LEVEL=
# ------------------------------------------------------------------------------
# 7. EzKhata app
# ------------------------------------------------------------------------------
# Supabase Postgres for app data (public schema) - fill in (no ?schema=evolution_api)
APP_DATABASE_URL=
# LLM (OpenAI-compatible: Groq / OpenRouter)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Optional: comma-separated keys tried in order when the main key hits a rate limit
LLM_FALLBACK_API_KEYS=
LLM_MODEL=openai/gpt-oss-120b
# Second provider, tried after every key above is rate limited (comma-separated; empty = off)
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=openai/gpt-oss-120b
# Which providers answer AI calls (groq, openrouter, gemini; empty = all). Calls take turns across all keys.
LLM_PROVIDERS=

# ------------------------------------------------------------------------------
# 8. Observability: LangSmith tracing (https://smith.langchain.com -> Settings -> API Keys)
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ezkhata-dev
# EU region only: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Image entries (OCR). Gemini is used when its key is set (free key: aistudio.google.com),
# else Google Cloud Vision (billing must be enabled). No key = photos are not read.
GEMINI_API_KEY=
# More Gemini keys (comma-separated): each has its own free quota. Used for photos and as an LLM.
GEMINI_FALLBACK_API_KEYS=
GEMINI_LLM_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-3.1-flash-lite-preview
# comma-separated, tried in order (each model has its own free daily quota of ~20 photos)
GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-flash-lite-latest
GOOGLE_VISION_API_KEY=

# WhatsApp (Evolution API) for the EzKhata server: app/main.py
# EVOLUTION_API_URL / EVOLUTION_API_KEY / EVOLUTION_INSTANCE also work instead of API_URL / API_KEY / INSTANCE
WEBHOOK_SECRET=long-random-string
MESSAGE_MAX_AGE_SECONDS=600
# Render free plan: the server pings these every KEEP_AWAKE_MINUTES so they don't sleep.
# RENDER_EXTERNAL_URL (the bot itself) is set by Render automatically.
KEEP_AWAKE_URLS=https://your-evolution.onrender.com
KEEP_AWAKE_MINUTES=5
